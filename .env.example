# Contoh variabel lingkungan untuk NaoVert.
#
# Salin menjadi .env.local saat menjalankan di komputer sendiri. Jangan kirim
# nilai asli ke chat atau commit. Berkas .env sudah diabaikan oleh Git.

# Alamat lengkap situs, tanpa garis miring di akhir.
NEXT_PUBLIC_SITUS_URL=https://naovert.sayba.id

# Endpoint Supabase Edge Function untuk pembayaran QRIS. Alamat ini bukan rahasia.
NEXT_PUBLIC_BAYAR_URL=https://zxoszpvrzgcsobivlgaq.supabase.co/functions/v1/bayar

# Kunci untuk membuka alat uji lokal di /gobiz. Gunakan kunci yang panjang dan acak.
GOBIZ_ADMIN_KEY=ganti-dengan-kunci-lokal
GOBIZ_ALLOW_REMOTE=0

# Kredensial Direct Integration GoBiz untuk pembuatan QRIS dinamis.
GOBIZ_CLIENT_ID=
GOBIZ_CLIENT_SECRET=
GOBIZ_OUTLET_ID=
GOBIZ_BASE_URL=https://api.gobiz.co.id
GOBIZ_OAUTH_URL=https://accounts.go-jek.com

# Payload QRIS statis merchant untuk uji QRIS dinamis di /gobiz/qris.
QRIS_PAYLOAD=

# Untuk uji sandbox, ganti kedua alamat di atas dengan:
# GOBIZ_BASE_URL=https://api.partner-sandbox.gobiz.co.id
# GOBIZ_OAUTH_URL=https://integration-goauth.gojekapi.com
